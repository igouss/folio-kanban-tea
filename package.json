{
  "name": "folio-kanban-monorepo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm -w @folio/web run dev",
    "build:web": "npm -w @folio/web run build",
    "start:desktop": "npm -w @folio/desktop-gpui start",
    "start:mobile": "npm -w @folio/mobile-fabric start",
    "android:mobile": "npm -w @folio/mobile-fabric run android",
    "ios:mobile": "npm -w @folio/mobile-fabric run ios",
    "test:core": "npm -w @folio/kanban-core test",
    "test:web": "npm -w @folio/web test",
    "test:desktop": "npm -w @folio/desktop-gpui test",
    "test:mobile": "npm -w @folio/mobile-fabric test",
    "test": "npm run test:core && npm run test:web && npm run test:desktop && npm run test:mobile",
    "typecheck:core": "npm -w @folio/kanban-core run typecheck",
    "typecheck:web": "npm -w @folio/web run typecheck",
    "typecheck:desktop": "npm -w @folio/desktop-gpui run typecheck",
    "typecheck:mobile": "npm -w @folio/mobile-fabric run typecheck",
    "typecheck": "npm run typecheck:core && npm run typecheck:web && npm run typecheck:desktop && npm run typecheck:mobile"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "5.9.3"
  }
}
